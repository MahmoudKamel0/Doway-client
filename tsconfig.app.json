{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["ES2023", "DOM"],
        "module": "esnext",
        "types": ["vite/client"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "paths": {
            "@app": ["./src/app/index.app.tsx"],
            "@components/*": ["./src/components/*"],
            "@config/*": ["./src/config/*"],
            "@fonts/*": ["./src/fonts/*"],
            "@i18n/*": ["./src/i18n/*"],
            "@lib/*": ["./src/lib/*"],
            "@pages/*": ["./src/pages/*"],
            "@security/*": ["./src/security/*"],
            "@services/*": ["./src/services/*"],
            "@store/*": ["./src/store/*"],
            "@styles/*": ["./src/styles/*"],
            "@public/*": ["./public/*"],
            "@/*": ["./src/*"]
        },

        /* Linting */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src"]
}
